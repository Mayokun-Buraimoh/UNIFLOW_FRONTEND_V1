# UniFlow frontend (Vite) — copy to `.env` or `.env.local` and adjust.
# Never commit `.env` files with real secrets.
#
# The API backend is not in this repo.
# Prefer VITE_BACKEND_URL (origin only); the app will call `${VITE_BACKEND_URL}/api/...`.
# Or set VITE_API_URL to the full base including `/api` if you need a non-standard path.

# Backend origin (no trailing slash, no /api). Production default in code is Render; override for ngrok/LAN.
VITE_BACKEND_URL=https://uniflow-backend-mdo3.onrender.com

# Native Android/iOS: `localhost` in the URLs above is the phone/tablet, not your Mac.
# Keep Mac dev as http://localhost:3000 if you like, and set this to your machine’s LAN API, e.g.:
# VITE_NATIVE_BACKEND_ORIGIN=http://192.168.1.50:3000
# Android emulator → host: VITE_NATIVE_BACKEND_ORIGIN=http://10.0.2.2:3000
# Or skip this and point VITE_BACKEND_URL at HTTPS ngrok instead.

# Optional: full API base override (must include `/api`)
# VITE_API_URL=https://YOUR_SUBDOMAIN.ngrok-free.dev/api

# Used for OAuth redirects and deep links
VITE_FRONTEND_URL=https://YOUR_SUBDOMAIN.ngrok-free.dev

# Django / UNIFLOW_AI (port 8000). Use the ngrok **Forwarding** URL for this service (often a second tunnel).
# Should match what you expose with `ngrok http 8000` (not the Node :3000 tunnel unless you proxy).
VITE_DJANGO_API_URL=https://YOUR_DJANGO_TUNNEL.ngrok-free.dev

# Native: if VITE_DJANGO_API_URL uses localhost, set LAN origin for Django on device (port 8000).
# VITE_NATIVE_DJANGO_ORIGIN=http://192.168.1.50:8000
# Android emulator → host: VITE_NATIVE_DJANGO_ORIGIN=http://10.0.2.2:8000

# Optional: override AI chat base only (defaults to VITE_DJANGO_API_URL + /api/v1)
# VITE_AI_API_URL=https://YOUR_DJANGO_TUNNEL.ngrok-free.dev/api/v1

# --- Android FCM (Capacitor) ---
# Do NOT put the Firebase *service account* JSON here. You need the Android client file:
# Firebase Console → Project settings → Your apps → Android (package com.uniflow.app) →
# Download google-services.json → save as UNIFLOW_FRONTEND/android/app/google-services.json
# (That file has "project_info" at the top. The service account JSON has "type":"service_account"
# and belongs only in UNIFLOW_BACKEND via GOOGLE_APPLICATION_CREDENTIALS.)
# See android/app/google-services.json.example for the expected shape (replace with your download).
