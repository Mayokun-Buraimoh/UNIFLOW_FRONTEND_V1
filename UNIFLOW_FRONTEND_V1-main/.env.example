# UniFlow frontend (Vite) — copy to `.env` or `.env.local` and adjust.
# Never commit `.env` files with real secrets.
#
# The API backend is not in this repo. Production default (when unset in build):
#   https://uniflow-backend-v1.onrender.com/api
# Override for local Node API:
# VITE_API_URL=http://localhost:3000/api
#
# Ruby (voice) uses the same Node API base above. Do not put OPENAI_* keys in the frontend.

# API base URL (no trailing slash). Required in .env before `npm run ios:sync`:
# VITE_API_URL=http://localhost:3000/api
# Production Render backend (uncomment for `npm run build` / `npm run ios:sync`):
# VITE_API_URL=https://uniflow-backend-v1.onrender.com/api
#
# Xcode iOS Simulator: localhost:3000 reaches the Mac running `npm run dev` in backend/.
# Physical iPhone: use your Mac LAN IP, e.g. VITE_API_URL=http://192.168.1.112:3000/api
# Or set VITE_DEV_MACHINE_HOST=192.168.1.112 with VITE_NATIVE_USE_LOCAL_API=true

# Used for OAuth redirects and deep links
VITE_FRONTEND_URL=http://localhost:5173

# Optional: Django / legacy notes API origin (without trailing slash)
# Local dev:
VITE_DJANGO_API_URL=http://localhost:8000
# Render hosted example:
# VITE_DJANGO_API_URL=https://uniflow-ai.onrender.com

# Optional override for AI client root (if omitted, defaults to VITE_DJANGO_API_URL + /api/v1)
# VITE_AI_API_URL=http://localhost:8000/api/v1

# Unified WebView wake word (openWakeWord WASM + ONNX Runtime Web)
# npm run setup:openwakeword && npm run setup:hey-ruby-models
# After training: npm run setup:hey-ruby-models -- --classifier ./output/hey_ruby/hey_ruby.onnx
# Classifier path: public/models/hey_ruby.onnx (fallback: hey jarvis in public/openwakeword/models/)
# VITE_OPENWAKEWORD_THRESHOLD=0.5

# Ruby realtime streaming voice (Deepgram-backed backend websocket).
# If omitted, frontend derives ws:// or wss:// from VITE_API_URL + /voice/realtime
# VITE_RUBY_REALTIME_WS_URL=ws://localhost:3000/api/voice/realtime

